# Database
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# JWT Secret for authentication (obrigatório: o servidor não inicia sem ele)
JWT_SECRET="your-super-secret-jwt-key-here"

# Lista de presentes
# true  = mais de um convidado pode escolher o mesmo item ("dar junto")
# false = o item fica bloqueado depois que alguém escolhe
MULTIPLOS_PRESENTEADORES="false"

# Origens extras liberadas no CORS (separadas por vírgula). Vazio = só o próprio site.
CORS_ORIGIN=""

# HTTP Basic Auth para proteção das páginas (a API /api fica fora: usa o token JWT)
# Com a lista pública, o normal é deixar desativado
BASIC_AUTH_ENABLED="false"
BASIC_AUTH_USER="admin"
BASIC_AUTH_PASS="senha123"

# Vite dev server Basic Auth
VITE_BASIC_AUTH_ENABLED="false"
VITE_BASIC_AUTH_USER="admin"
VITE_BASIC_AUTH_PASS="senha123"

# Environment
NODE_ENV="development"